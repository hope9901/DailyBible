# ==========================================
# 1. Notion API 및 데이터베이스 ID 설정
# ==========================================
NOTION_API_KEY="secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# 일일 생명의 삶 크롤링 본문이 저장되는 노션 DB ID
NOTION_DAILY_WORD_DB_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# 회원(사용자) 정보가 저장되는 노션 DB ID
NOTION_USERS_DB_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# 날짜별 QT 읽음 체크 및 느낀점(은혜 받은점)이 저장되는 노션 DB ID
NOTION_QT_LOGS_DB_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ==========================================
# 2. NextAuth (소셜 로그인) 설정
# ==========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace_with_random_secret_string_32_chars"

# 카카오 로그인 (https://developers.kakao.com)
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# 네이버 로그인 (https://developers.naver.com)
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# 구글 로그인 (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ==========================================
# 3. 크롤러 보안 키 (GitHub Actions / API 호출용)
# ==========================================
CRON_SECRET="replace_with_cron_secret_key"
